# ClauseLens Environment Variables

# App Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Embedding & Reranking Models
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage Paths (relative to backend/)
CHROMA_PERSIST_DIR=data/indices/chroma
BM25_PERSIST_DIR=data/indices/bm25

# RRF & Retrieval Hyperparameters
RRF_K=60
TOP_K_DENSE=25
TOP_K_SPARSE=25
TOP_N_RERANK=15
TOP_K_FINAL=5

# Optional LLM API Key (e.g. Gemini / OpenAI / Anthropic)
GEMINI_API_KEY=
OPENAI_API_KEY=

