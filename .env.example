# ClauseLens Environment Variables

# App Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Embedding & Reranking Models
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage Paths (relative to root)
CHROMA_PERSIST_DIR=backend/data/indices/chroma
BM25_PERSIST_DIR=backend/data/indices/bm25

# RRF & Retrieval Hyperparameters
RRF_K=60
TOP_K_DENSE=25
TOP_K_SPARSE=25
TOP_N_RERANK=15
TOP_K_FINAL=5

# ==============================================================
# LLM Providers Configuration
# ==============================================================

# Priority 1: Inception AI (Mercury-3)
LLM_PROVIDER=inception
INCEPTION_API_KEY=your_inception_api_key_here
INCEPTION_BASE_URL=https://api.inception.ai/v1
INCEPTION_MODEL=mercury-3

# Priority 2: Google Gemini (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Priority 3: Groq (Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
